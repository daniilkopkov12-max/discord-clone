# Environment configuration
PORT=5000
NODE_ENV=development

# Database connection (SQLite for local development, PostgreSQL for Render production)
DATABASE_URL="file:./dev.db"

# JWT Secret key for user sessions
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Client URL (for CORS during separated dev mode)
CLIENT_URL="http://localhost:5173"

# Optional: LiveKit Cloud credentials (WebRTC mesh works natively without them)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
